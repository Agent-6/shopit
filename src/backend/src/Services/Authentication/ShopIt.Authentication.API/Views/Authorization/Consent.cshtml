@using OpenIddict.Abstractions
@model OpenIddictRequest
@{
    ViewData["Title"] = "Authorization Consent";
}

<div class="flex flex-col space-y-2 text-center mb-6">
    <div class="mx-auto bg-primary text-primary-foreground h-14 w-14 rounded-2xl flex items-center justify-center mb-2 shadow-sm">
        <i data-lucide="shield" class="h-7 w-7"></i>
    </div>
    <h1 class="text-2xl font-semibold tracking-tight">Permission Request</h1>
    <p class="text-sm text-muted-foreground">
        The application <span class="font-medium text-foreground">@Model.ClientId</span> is requesting access to your account.
    </p>
</div>

<div class="mb-6 space-y-3">
    <p class="text-xs uppercase font-semibold text-muted-foreground tracking-wider mb-2">This will allow the application to:</p>
    
    <div class="rounded-lg border bg-muted/50 p-4 space-y-3">
        @foreach (var scope in Model.GetScopes())
        {
            <div class="flex items-center space-x-3">
                <div class="bg-primary/10 rounded-full p-1 border border-primary/20">
                    <i data-lucide="check" class="h-4 w-4 text-primary"></i>
                </div>
                <span class="text-sm font-medium text-foreground leading-none">@scope</span>
            </div>
        }
    </div>
</div>

<form asp-controller="Authorization" asp-action="Authorize" method="post" class="flex gap-3">
    @foreach (var parameter in Context.Request.HasFormContentType ? Context.Request.Form.ToList() : Context.Request.Query.Select(q => new KeyValuePair<string, Microsoft.Extensions.Primitives.StringValues>(q.Key, q.Value)).ToList())
    {
        <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
    }

    <button type="submit" name="submit.Deny" value="Deny" class="btn-outline flex-1">
        Deny
    </button>
    <button type="submit" name="submit.Accept" value="Accept" class="btn-primary flex-1">
        Allow Access
    </button>
</form>
