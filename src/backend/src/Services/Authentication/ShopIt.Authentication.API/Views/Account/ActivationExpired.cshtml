@{
    ViewData["Title"] = "Invitation Expired";
    var email = ViewData["Email"] as string;
}

<div class="flex flex-col items-center justify-center space-y-4 text-center">
    <div class="bg-amber-500/10 text-amber-600 dark:text-amber-500 h-16 w-16 rounded-full flex items-center justify-center mb-2">
        <i data-lucide="clock" class="h-8 w-8"></i>
    </div>

    <h1 class="text-2xl font-semibold tracking-tight">Your invitation has expired</h1>

    <p class="text-sm text-muted-foreground mb-4">
        This activation link is no longer valid. Request a new invitation and we'll email you a fresh link.
    </p>

    <form asp-controller="Account" asp-action="ResendInvitation" method="post" class="w-full space-y-4">
        @Html.AntiForgeryToken()

        <div class="space-y-2 text-left">
            <label for="email" class="text-sm font-medium leading-none">Email address</label>
            <input name="email" id="email" type="email" class="input-shadcn" value="@email" placeholder="name@example.com" required autofocus />
        </div>

        <button type="submit" class="btn-primary w-full">
            <i data-lucide="mail-check" class="mr-2 h-4 w-4"></i> Send New Invitation
        </button>
    </form>

    <a asp-action="Login" class="text-muted-foreground hover:text-foreground inline-flex items-center text-sm transition-colors mt-4">
        <i data-lucide="arrow-left" class="mr-2 h-4 w-4"></i> Back to login
    </a>
</div>
