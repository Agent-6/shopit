@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

<div class="flex flex-col items-center justify-center space-y-4 text-center">
    <div class="bg-green-500/10 text-green-600 dark:text-green-500 h-16 w-16 rounded-full flex items-center justify-center mb-2">
        <i data-lucide="mail-open" class="h-8 w-8"></i>
    </div>
    
    <h1 class="text-2xl font-semibold tracking-tight">Check your email</h1>
    
    <p class="text-sm text-muted-foreground mb-6">
        We have sent a password reset link to your email address. 
        <br/><br/>
        <span class="text-xs italic bg-muted p-2 rounded block mt-2 border">
            Mock Mode: Click <a asp-action="ResetPassword" asp-route-email="mock@user.com" asp-route-token="dummytsksjdhfks" class="text-primary font-medium hover:underline">here</a> to simulate the reset link.
        </span>
    </p>

    <a asp-action="Login" class="btn-outline w-full">
        <i data-lucide="arrow-left" class="mr-2 h-4 w-4"></i> Return to login
    </a>
</div>
