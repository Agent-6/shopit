@{
    ViewData["Title"] = "Forgot Password";
}

<div class="flex flex-col space-y-2 text-center mb-6">
    <div class="mx-auto bg-primary/10 text-primary h-12 w-12 rounded-lg flex items-center justify-center mb-2">
        <i data-lucide="key-round" class="h-6 w-6"></i>
    </div>
    <h1 class="text-2xl font-semibold tracking-tight">Forgot password?</h1>
    <p class="text-sm text-muted-foreground">Enter your email to receive a reset link</p>
</div>

<form asp-controller="Account" asp-action="ForgotPassword" method="post" class="space-y-4">
    <div asp-validation-summary="All" class="text-[0.8rem] font-medium text-destructive"></div>

    <div class="space-y-2">
        <label for="email" class="text-sm font-medium leading-none">Email address</label>
        <input name="email" id="email" type="email" class="input-shadcn" placeholder="name@example.com" required autofocus />
    </div>

    <button type="submit" class="btn-primary w-full mt-2">
        <i data-lucide="mail-check" class="mr-2 h-4 w-4"></i> Send Reset Link
    </button>
</form>

<div class="mt-6 text-center text-sm">
    <a asp-action="Login" class="text-muted-foreground hover:text-foreground inline-flex items-center transition-colors">
        <i data-lucide="arrow-left" class="mr-2 h-4 w-4"></i> Back to login
    </a>
</div>
