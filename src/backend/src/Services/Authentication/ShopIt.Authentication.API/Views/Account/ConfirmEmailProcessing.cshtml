@{
    ViewData["Title"] = "Confirm Email";
    var requestId = ViewData["RequestId"] as Guid? ?? Guid.Empty;
    var email = ViewData["Email"] as string;
    var returnUrl = ViewData["ReturnUrl"] as string;

    ViewData["FlowRequestId"] = requestId;
    ViewData["FlowTitle"] = "Confirming your email";
    ViewData["FlowPendingMessage"] = "Your verification code has been sent to the Identity service for validation. This can take a few seconds.";
    ViewData["FlowSuccessTitle"] = "Email Confirmed";
    ViewData["FlowSuccessMessage"] = "Your email address has been confirmed. You can now sign in.";
    ViewData["FlowSuccessUrl"] = Url.Action("Login", new { returnUrl });
    ViewData["FlowSuccessUrlLabel"] = "Proceed to login";
    ViewData["FlowFailureUrl"] = Url.Action("ConfirmEmail", new { email, returnUrl });
}

<div class="flex flex-col items-center justify-center">
    @await Html.PartialAsync("_FlowStatus")
</div>
