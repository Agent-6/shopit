@model ShopIt.Authentication.Presentation.Controllers.ActivateViewModel
@{
    ViewData["Title"] = "Activate Your Account";
}

<div class="flex flex-col space-y-2 text-center mb-6">
    <div class="mx-auto bg-primary/10 text-primary h-12 w-12 rounded-lg flex items-center justify-center mb-2">
        <i data-lucide="user-check" class="h-6 w-6"></i>
    </div>
    <h1 class="text-2xl font-semibold tracking-tight">Activate your account</h1>
    <p class="text-sm text-muted-foreground">You're one step away — choose a password to finish setting up your account</p>
</div>

<form asp-controller="Account" asp-action="Activate" method="post" class="space-y-4">
    <div asp-validation-summary="All" class="text-[0.8rem] font-medium text-destructive"></div>

    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Token" />
    <input type="hidden" asp-for="ClientId" />

    <div class="space-y-2">
        <label asp-for="NewPassword" class="text-sm font-medium leading-none">New Password</label>
        <input asp-for="NewPassword" type="password" class="input-shadcn" placeholder="Min. 8 characters with uppercase, lowercase and a number" required autofocus />
    </div>

    <div class="space-y-2">
        <label asp-for="ConfirmPassword" class="text-sm font-medium leading-none">Confirm Password</label>
        <input asp-for="ConfirmPassword" type="password" class="input-shadcn" required />
    </div>

    <button type="submit" class="btn-primary w-full mt-2">
        <i data-lucide="rocket" class="mr-2 h-4 w-4"></i> Activate &amp; Sign In
    </button>
</form>
