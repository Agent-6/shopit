@model ShopIt.Authentication.Presentation.Controllers.LoginRequest
@{
    ViewData["Title"] = "Log in";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="flex flex-col space-y-2 text-center mb-6">
    <div class="mx-auto bg-primary text-primary-foreground h-12 w-12 rounded-lg flex items-center justify-center mb-2">
        <i data-lucide="lock" class="h-6 w-6"></i>
    </div>
    <h1 class="text-2xl font-semibold tracking-tight">Welcome back</h1>
    <p class="text-sm text-muted-foreground">Enter your credentials to sign in to your account</p>
</div>

<form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" class="space-y-4">
    <div asp-validation-summary="All" class="text-[0.8rem] font-medium text-destructive"></div>

    <div class="space-y-2">
        <label asp-for="Email" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Email address</label>
        <input asp-for="Email" type="text" class="input-shadcn" placeholder="name@example.com" required autofocus />
    </div>

    <div class="space-y-2">
        <div class="flex items-center justify-between">
            <label asp-for="Password" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Password</label>
            <a asp-action="ForgotPassword" class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors">Forgot password?</a>
        </div>
        <input asp-for="Password" type="password" class="input-shadcn" required />
    </div>

    <button type="submit" class="btn-primary w-full mt-2">
        <i data-lucide="log-in" class="mr-2 h-4 w-4"></i> Sign In
    </button>
</form>
