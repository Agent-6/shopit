@{
    ViewData["Title"] = "Reset Password";
    var requestId = ViewData["RequestId"] as Guid? ?? Guid.Empty;
    var email = ViewData["Email"] as string;
    var token = ViewData["Token"] as string;

    ViewData["FlowRequestId"] = requestId;
    ViewData["FlowTitle"] = "Resetting your password";
    ViewData["FlowPendingMessage"] = "Your request has been sent to the Identity service. This can take a few seconds.";
    ViewData["FlowSuccessTitle"] = "Password Reset Successful";
    ViewData["FlowSuccessMessage"] = "Your password has been reset. You can now sign in with your new password.";
    ViewData["FlowSuccessUrl"] = Url.Action("Login");
    ViewData["FlowSuccessUrlLabel"] = "Proceed to login";
    ViewData["FlowFailureUrl"] = Url.Action("ResetPassword", new { email, token });
}

<div class="flex flex-col items-center justify-center">
    @await Html.PartialAsync("_FlowStatus")
</div>
