@model ShopIt.Authentication.Presentation.Controllers.ResetPasswordRequest
@{
    ViewData["Title"] = "Reset Password";
}

<div class="flex flex-col space-y-2 text-center mb-6">
    <div class="mx-auto bg-primary/10 text-primary h-12 w-12 rounded-lg flex items-center justify-center mb-2">
        <i data-lucide="shield-check" class="h-6 w-6"></i>
    </div>
    <h1 class="text-2xl font-semibold tracking-tight">Reset Password</h1>
    <p class="text-sm text-muted-foreground">Enter your new secure password below</p>
</div>

<form asp-controller="Account" asp-action="ResetPassword" method="post" class="space-y-4">
    <div asp-validation-summary="All" class="text-[0.8rem] font-medium text-destructive"></div>
    
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />

    <div class="space-y-2">
        <label asp-for="Email" class="text-sm font-medium leading-none text-muted-foreground">Email address</label>
        <input asp-for="Email" type="email" disabled class="input-shadcn bg-muted text-muted-foreground" />
    </div>

    <div class="space-y-2">
        <label asp-for="NewPassword" class="text-sm font-medium leading-none">New Password</label>
        <input asp-for="NewPassword" type="password" class="input-shadcn" required autofocus />
    </div>

    <div class="space-y-2">
        <label asp-for="ConfirmPassword" class="text-sm font-medium leading-none">Confirm New Password</label>
        <input asp-for="ConfirmPassword" type="password" class="input-shadcn" required />
    </div>

    <button type="submit" class="btn-primary w-full mt-2">
        <i data-lucide="save" class="mr-2 h-4 w-4"></i> Reset Password
    </button>
</form>
