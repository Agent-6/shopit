@{
    ViewData["Title"] = "Reset Password Confirmation";
}

<div class="flex flex-col items-center justify-center space-y-4 text-center">
    <div class="bg-green-500/10 text-green-600 dark:text-green-500 h-16 w-16 rounded-full flex items-center justify-center mb-2">
        <i data-lucide="check-circle-2" class="h-8 w-8"></i>
    </div>
    
    <h1 class="text-2xl font-semibold tracking-tight">Password Reset Successful</h1>
    
    <p class="text-sm text-muted-foreground mb-6">
        Your password has been successfully updated. You can now use your new password to sign in.
    </p>

    <a asp-action="Login" class="btn-primary w-full">
        Proceed to Login <i data-lucide="arrow-right" class="ml-2 h-4 w-4"></i>
    </a>
</div>
