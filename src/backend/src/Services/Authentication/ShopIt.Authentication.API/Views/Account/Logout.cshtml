@{
    ViewData["Title"] = "Log out";
}

<div class="flex flex-col space-y-2 text-center mb-6">
    <div class="mx-auto bg-destructive/10 text-destructive h-12 w-12 rounded-lg flex items-center justify-center mb-2">
        <i data-lucide="log-out" class="h-6 w-6"></i>
    </div>
    <h1 class="text-2xl font-semibold tracking-tight">Sign Out</h1>
    <p class="text-sm text-muted-foreground">Are you sure you want to sign out of your account?</p>
</div>

<form asp-controller="Account" asp-action="LogoutConfirm" method="post" class="flex flex-col gap-3">
    <button type="submit" class="btn-primary w-full bg-destructive text-destructive-foreground hover:bg-destructive/90">
        Yes, sign me out
    </button>
    <a href="javascript:history.back()" class="btn-outline w-full">
        Cancel
    </a>
</form>
